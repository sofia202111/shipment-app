@model ShipmentsApp.Models.Shipment

<div class="container mt-5">

    <div class="card shadow p-4">

        <h1 class="mb-4">Nuevo Envío</h1>
        <div class="alert alert-secondary mt-4">
             <h5 class="mb-3">
                 Condiciones para crear el shipment
            </h5>
            <ul class="mb-0">
            <li>
                El país de origen no debe ser igual al país de destino.
            </li>
            <li>
                El peso debe ser mayor que cero.
            </li>
            <li>
                El número de guía o tracking number debe ser obligatorio y único.
            </li>
            <li>
                La fecha estimada de entrega no debe ser menor que la fecha de creación.
            </li>
    </ul>
     Si no se cumple estas consiciiones no se podra fuardar el reegistro hasta que se cumplan las consiciones

</div>

        <form asp-action="Create">

            <div class="row">

                <div class="col-md-6 mb-3">
                    <label class="form-label">Tracking Number</label>
                    <input asp-for="TrackingNumber" class="form-control" />
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Peso KG</label>
                    <input asp-for="PesoKg" class="form-control" />
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">País Origen</label>
                    <input asp-for="PaisOrigen" class="form-control" />
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">País Destino</label>
                    <input asp-for="PaisDestino" class="form-control" />
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Ciudad Origen</label>
                    <input asp-for="CiudadOrigen" class="form-control" />
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Ciudad Destino</label>
                    <input asp-for="CiudadDestino" class="form-control" />
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Remitente</label>
                    <input asp-for="NombreRemitente" class="form-control" />
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Destinatario</label>
                    <input asp-for="NombreDestinatario" class="form-control" />
                </div>

                <div class="col-12 mb-3">
                    <label class="form-label">Descripción</label>
                    <textarea asp-for="DescripcionMercancia"
                              class="form-control"></textarea>
                </div>

                <div class="col-md-6 mb-4">
                    <label class="form-label">Fecha Estimada</label>
                    <input asp-for="FechaEstimadaEntrega"
                           type="date"
                           class="form-control" />
                </div>

            </div>

            <button type="submit" class="btn btn-success">
                Guardar
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                Volver
            </a>
            

        </form>

    </div>

</div>