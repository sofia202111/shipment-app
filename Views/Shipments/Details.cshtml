@model ShipmentsApp.Models.Shipment
@{
    ViewData["Title"] = "Detalle del Envío";
}

<h2>Detalle — @Model.TrackingNumber</h2>
<hr />

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-4">Número de Guía</dt>
            <dd class="col-sm-8">@Model.TrackingNumber</dd>

            <dt class="col-sm-4">Origen</dt>
            <dd class="col-sm-8">@Model.CiudadOrigen, @Model.PaisOrigen</dd>

            <dt class="col-sm-4">Destino</dt>
            <dd class="col-sm-8">@Model.CiudadDestino, @Model.PaisDestino</dd>

            <dt class="col-sm-4">Remitente</dt>
            <dd class="col-sm-8">@Model.NombreRemitente</dd>

            <dt class="col-sm-4">Destinatario</dt>
            <dd class="col-sm-8">@Model.NombreDestinatario</dd>

            <dt class="col-sm-4">Descripción</dt>
            <dd class="col-sm-8">@Model.DescripcionMercancia</dd>

            <dt class="col-sm-4">Peso</dt>
            <dd class="col-sm-8">@Model.PesoKg kg</dd>

            <dt class="col-sm-4">Estado</dt>
            <dd class="col-sm-8">
                @{
                    var badge = Model.Estado switch
                    {
                        0 => "secondary",
                        1 => "primary",
                        2 => "success",
                        3 => "danger",
                        _ => "secondary"
                    };
                }
                <span class="badge bg-@badge fs-6">@Model.EstadoTexto</span>
            </dd>

            <dt class="col-sm-4">Fecha Creación</dt>
            <dd class="col-sm-8">@Model.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</dd>

            <dt class="col-sm-4">Fecha Est. Entrega</dt>
            <dd class="col-sm-8">@Model.FechaEstimadaEntrega.ToString("dd/MM/yyyy")</dd>
        </dl>
    </div>
</div>

<div class="mt-3">
    @if (Model.Estado != 2 && Model.Estado != 3)
    {
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Editar</a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Cancelar envío</a>
    }
    <a asp-action="Index" class="btn btn-secondary">Volver al listado</a>
</div>